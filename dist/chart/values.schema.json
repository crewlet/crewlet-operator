{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Refuses the values the chart's generated templates read but the operator cannot run with. Every other value is described in values.yaml.",
  "type": "object",
  "properties": {
    "manager": {
      "type": "object",
      "if": {
        "properties": {"replicas": {"type": "integer", "minimum": 2}},
        "required": ["replicas"]
      },
      "then": {
        "properties": {
          "args": {
            "description": "More than one replica is safe only with leader election, which the manager runs unless it is turned off.",
            "not": {"contains": {"type": "string", "pattern": "^--?leader-elect=(false|f|0|FALSE|False|F)$"}}
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "namespaced": {
          "description": "Unsupported: the operator reads cluster-scoped EngineClasses and runs Companies in every namespace, so its role must be a ClusterRole.",
          "const": false
        }
      }
    },
    "tenantProvisioner": {
      "type": "object",
      "if": {
        "properties": {"enabled": {"const": true}},
        "required": ["enabled"]
      },
      "then": {
        "properties": {
          "subjects": {
            "description": "The admission policy that keeps the provisioner to tenants' namespaces matches these subjects; without them the role would be unchecked.",
            "minItems": 1
          }
        }
      },
      "properties": {
        "enabled": {"type": "boolean"},
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": {"enum": ["ServiceAccount", "User", "Group"]},
              "name": {"type": "string", "minLength": 1},
              "namespace": {"type": "string"},
              "apiGroup": {"type": "string"}
            },
            "if": {"properties": {"kind": {"const": "ServiceAccount"}}},
            "then": {"required": ["namespace"]}
          }
        },
        "namespaceLabels": {
          "type": "object",
          "required": ["tenant"],
          "properties": {
            "tenant": {"type": "string", "minLength": 1},
            "required": {"type": "object", "additionalProperties": {"type": "string"}},
            "protectedPrefixes": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "if": {
        "properties": {"enabled": {"const": true}},
        "required": ["enabled"]
      },
      "then": {
        "properties": {
          "signingKeySecret": {
            "description": "The proxy checks every tenant credential against this key; without it no connection could be admitted.",
            "required": ["name"],
            "properties": {"name": {"minLength": 1}}
          },
          "tiers": {
            "description": "A proxy with no tier serves no namespace.",
            "minItems": 1
          }
        }
      },
      "properties": {
        "enabled": {"type": "boolean"},
        "signingKeySecret": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A tier's proxy and its policy; an unknown field would be refused by the proxy at start, so it is refused here.",
            "additionalProperties": false,
            "required": ["name", "trustTiers"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"},
              "trustTiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 63}},
              "replicas": {"type": "integer", "minimum": 1},
              "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
              "allowHosts": {"type": "array", "items": {"type": "string", "pattern": "^([*][.])?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?[.]?$"}},
              "denyHosts": {"type": "array", "items": {"type": "string", "pattern": "^([*][.])?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?[.]?$"}},
              "allowIPLiterals": {"type": "boolean"},
              "deniedCIDRs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "maxConnectionSeconds": {"type": "integer", "minimum": 1},
              "idleTimeoutSeconds": {"type": "integer", "minimum": 1},
              "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
              "tolerations": {"type": "array"},
              "resources": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
