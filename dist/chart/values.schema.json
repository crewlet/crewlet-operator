{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Refuses the values the chart's generated templates read but the operator cannot run with. Every other value is described in values.yaml.",
  "type": "object",
  "properties": {
    "manager": {
      "type": "object",
      "if": {
        "properties": {"replicas": {"type": "integer", "minimum": 2}},
        "required": ["replicas"]
      },
      "then": {
        "properties": {
          "args": {
            "description": "More than one replica is safe only with leader election, which the manager runs unless it is turned off.",
            "not": {"contains": {"type": "string", "pattern": "^--?leader-elect=(false|f|0|FALSE|False|F)$"}}
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "namespaced": {
          "description": "Unsupported: the operator reads cluster-scoped EngineClasses and runs Companies in every namespace, so its role must be a ClusterRole.",
          "const": false
        }
      }
    },
    "tenantProvisioner": {
      "type": "object",
      "if": {
        "properties": {"enabled": {"const": true}},
        "required": ["enabled"]
      },
      "then": {
        "properties": {
          "subjects": {
            "description": "The admission policy that keeps the provisioner to tenants' namespaces matches these subjects; without them the role would be unchecked.",
            "minItems": 1
          }
        }
      },
      "properties": {
        "enabled": {"type": "boolean"},
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": {"enum": ["ServiceAccount", "User", "Group"]},
              "name": {"type": "string", "minLength": 1},
              "namespace": {"type": "string"},
              "apiGroup": {"type": "string"}
            },
            "if": {"properties": {"kind": {"const": "ServiceAccount"}}},
            "then": {"required": ["namespace"]}
          }
        },
        "namespaceLabels": {
          "type": "object",
          "required": ["tenant"],
          "properties": {
            "tenant": {"type": "string", "minLength": 1},
            "required": {"type": "object", "additionalProperties": {"type": "string"}},
            "protectedPrefixes": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "immutable": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "requiredKeys": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "allowedValues": {
              "type": "object",
              "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "namePrefix": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[-a-z0-9])?)?$"}
          }
        }
      }
    },
    "cellPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "classLabel": {"type": "string", "minLength": 1},
        "tenantPods": {
          "type": "object",
          "properties": {
            "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "value", "effect"],
                "properties": {
                  "key": {"type": "string", "minLength": 1},
                  "value": {"type": "string"},
                  "effect": {"enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]}
                }
              }
            }
          }
        }
      }
    },
    "internalTLS": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "clusterResourceNamespace": {"type": "string", "minLength": 1},
        "commonName": {"type": "string", "minLength": 1, "maxLength": 64},
        "caDuration": {"type": "string", "pattern": "^[0-9]+h$"},
        "caRenewBefore": {"type": "string", "pattern": "^[0-9]+h$"}
      }
    }
  }
}
